<?xml version="1.0" encoding="utf-8"?>
<!--
  內網優先：在家直連 Jellyfin 與轉碼伺服器的內網 IP，走 http。
  內網位址由使用者設定、無法在建置時列舉，所以全域允許明文；外部網址一律用 https。
  外部 https 在 Android 7.0 的問題（ISRG Root X1、P-384 憑證）留待第二版內建 Conscrypt 處理。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
